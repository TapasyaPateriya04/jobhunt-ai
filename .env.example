# JobHunt AI configuration. Copy to `.env` and adjust. `.env` must never be committed.
# Every value below is optional; the defaults shown are used when a variable is unset.

# SQLAlchemy database URL (local SQLite file by default).
DATABASE_URL=sqlite:///jobhunt.db

# Use a local Ollama server first for LLM calls (true/false).
USE_OLLAMA=true
# Ollama server URL. Must be localhost / 127.0.0.1 / ::1 unless ALLOW_REMOTE_LLM=true.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model name (run `ollama pull llama3.2:3b` first; mistral is better but slow without a GPU).
OLLAMA_MODEL=llama3.2:3b
# Allow OLLAMA_BASE_URL to point at a non-local host. Leave false unless you trust that host:
# resumes and job text are sent to it.
ALLOW_REMOTE_LLM=false

# Optional Google Gemini fallback. Get a free key at https://aistudio.google.com.
# Leave empty to disable. Never paste a real key into this example file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Folder where generated cover letters / resume suggestions are written.
DOCS_DIR=~/jobhunt_docs

# Ethical scraping: minimum seconds between requests to a site, and max jobs per scrape session.
SCRAPE_DELAY_SECONDS=3.0
MAX_JOBS_PER_SESSION=50

# Company job boards to read, as comma-separated slugs (the last part of the careers URL:
# boards.greenhouse.io/<slug> or jobs.lever.co/<slug>). Used by the greenhouse / lever sources.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=

# Where you live, so jobs you cannot take are ranked down: postings restricted to other
# countries, other time zones or another language. Leave CANDIDATE_COUNTRY empty to turn
# this off. Cities are optional and only used to name a match ("In Bangalore").
CANDIDATE_COUNTRY=
CANDIDATE_CITIES=

# Maximum accepted resume upload size in bytes.
UPLOAD_MAX_BYTES=2000000

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
